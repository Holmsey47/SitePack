{
  "expo": {
    "name": "SitePack",
    "slug": "sitepack",
    "version": "0.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sitepack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.sitepack.app"
    },
    "android": {
      "package": "uk.sitepack.app",
      "versionCode": 4,
      "permissions": ["android.permission.CAMERA"],
      "allowBackup": false,
      "blockedPermissions": [
        "SYSTEM_ALERT_WINDOW",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "sitepack-preview.vercel.app",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "sitepack-preview.vercel.app",
              "path": "/set-password"
            },
            {
              "scheme": "https",
              "host": "sitepack-preview.vercel.app",
              "path": "/reset"
            },
            {
              "scheme": "https",
              "host": "sitepack-preview.vercel.app",
              "pathPrefix": "/reset/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#121820",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121820",
          "dark": {
            "backgroundColor": "#121820"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "SitePack uses a photo you choose for a snag or a variation.",
          "cameraPermission": "SitePack uses the camera so you can take a photo of a snag or a variation.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "./plugins/withReleaseSigning.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
