# Copy to .env.local. The app uses fixture data only when EXPO_PUBLIC_USE_FIXTURES=1.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Expo + Supabase samples
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Force fixture mode. A production web export refuses this.
# EXPO_PUBLIC_USE_FIXTURES=1

# Edge functions. JSON object whose "default" value is an sb_secret_ key.
# join-with-code, login-with-username, and redeem-reset-code fail closed when this is missing or invalid.
# No real value belongs in this file.
# SUPABASE_SECRET_KEYS={"default":"sb_secret_..."}
